Table booking_session {
  booking_session_id int [pk, increment]
  university_id int [not null]
  booking_id int [not null]
  service_mode_id int [not null, ref: > service_mode_category.service_mode_id]
  online_channel_category_id int [ref: > online_channel_category.online_channel_category_id]
  booking_session_join_url text
  booking_session_phone_number varchar(30)
  booking_session_location_text varchar(200)
  booking_session_extra_detail text
  booking_session_is_link_visible boolean [default: true]
  provided_by_account_id int [ref: > account.account_id]
  provided_at timestamptz


  Note: 'รายละเอียด session จริง (ลิงก์/สถานที่)'
}

Table booking_assignment {
  booking_assignment_id int [pk, increment]
  university_id int [not null]
  booking_id int [not null]
  consultant_id int [not null]
  consultant_university_id int [not null, ref: > university.university_id]
  borrow_assignment_id int [ref: > borrow_assignment.borrow_assignment_id]
  assigned_by_account_id int [ref: > account.account_id]
  is_auto_assigned boolean [default: false]
  is_active boolean [default: true]
  assigned_note text
  assigned_at timestamptz [default: `now()`]

  Note: 'ประวัติมอบหมาย consultant (รวมยืมตัว)'
}

Table risk_level_category {
  risk_level_id int [pk, note: '1-5']
  code varchar(20) [unique, not null, note: 'VERY_LOW, LOW, MEDIUM, HIGH, VERY_HIGH']
  name_th varchar(50) [not null, note: 'ต่ำมาก, ต่ำ, ปานกลาง, สูง, สูงมาก']
  name_en varchar(50) [not null]
  color varchar(10) [default: '#94a3b8']
  sort_order int [default: 0]

  Note: 'ระดับความเสี่ยง (Lookup) — 1=ต่ำมาก, 2=ต่ำ, 3=ปานกลาง, 4=สูง, 5=สูงมาก'
}

Table booking_outcome {
  booking_id int [not null]
  university_id int [not null]
  booking_outcome_consultant_note text [not null]
  booking_outcome_next_step text
  risk_level_id int [ref: > risk_level_category.risk_level_id, note: 'FK ระดับความเสี่ยง (1-5)']
  booking_outcome_recorded_at timestamp [default: `now()`]


  Note: 'ผลการให้คำปรึกษา (1:1 กับ booking)'
}

Table booking_agreement_signature {
  booking_agreement_signature_id int [pk, increment]
  university_id int [not null]
  booking_id int [not null]
  student_id int [not null]
  signature_method ConsentSignatureMethod [default: 'DRAW']
  signature_payload json [not null]


  Note: 'ลายเซ็นยินยอม (1 booking ต่อ 1 signature)'
}

Table cancellation_reason {
  cancellation_reason_id int [pk, increment]
  cancellation_reason_code varchar(20) [unique, not null]
  cancellation_reason_name_th varchar(100) [not null]
  cancellation_reason_name_en varchar(100)
  cancellation_reason_description text

  Note: 'Master เหตุผลยกเลิกการจอง'
}

Table booking_cancellation {
  booking_id int [not null]
  university_id int [not null]
  cancellation_reason_id int [not null, ref: > cancellation_reason.cancellation_reason_id]
  booking_cancellation_note text
  booking_cancellation_cancelled_by_id int [not null, ref: > account.account_id]
  booking_cancellation_cancelled_at timestamp [default: `now()`]


  Note: 'รายละเอียดการยกเลิกจอง (1:1 กับ booking)'
}


// =====================
// ATTENDANCE & EXCEPTION
// =====================

Table booking_attendance {
  university_id int [not null]
  booking_id int [not null]
  booking_attendance_status AttendanceStatus [default: 'PENDING']
  booking_attendance_checked_in_at timestamptz
  booking_attendance_late_minutes int
  booking_attendance_note text
  booking_attendance_marked_by_id int [ref: > account.account_id]
  booking_attendance_marked_at timestamptz


  Note: 'สถานะเข้าร่วมของนิสิต (เช็คอิน/มาสาย/ไม่มา)'
}

Table exception_reason {
  exception_reason_id int [pk, increment]
  exception_reason_code varchar(30) [unique, not null]
  exception_reason_name_th varchar(100) [not null]
  exception_reason_name_en varchar(100)
  exception_reason_description text
  exception_reason_is_active boolean [default: true]
  exception_reason_sort_order int [default: 0]

  Note: 'Master เหตุผลขอยกเว้น'
}

Table booking_exception_request {
  booking_exception_request_id int [pk, increment]
  university_id int [not null]
  booking_id int [not null]
  student_id int [not null]
  exception_reason_id int [ref: > exception_reason.exception_reason_id]
  booking_exception_reason_code varchar(50) [not null]
  booking_exception_reason_detail text [not null]
  booking_exception_status ExceptionStatus [default: 'DRAFT']
  booking_exception_deadline_at timestamptz
  booking_exception_requested_at timestamptz [default: `now()`]
  booking_exception_submitted_at timestamptz
  booking_exception_reviewed_by_id int [ref: > account.account_id]
  booking_exception_reviewed_at timestamptz
  booking_exception_decision_note text


  Note: 'คำร้องขอยกเว้น (ไม่มา/สาย)'
}

Table booking_exception_evidence {
  booking_exception_evidence_id int [pk, increment]
  booking_exception_request_id int [not null, ref: > booking_exception_request.booking_exception_request_id]
  booking_exception_evidence_url text [not null]
  booking_exception_evidence_name varchar(255)
  booking_exception_evidence_type varchar(50)
  booking_exception_evidence_size int
  booking_exception_evidence_uploaded_at timestamptz [default: `now()`]

  Note: 'หลักฐานแนบคำร้อง exception'
}

Table booking_punishment_log {
  booking_discipline_log_id int [pk, increment]
  university_id int [not null, ref: > university.university_id]
  student_id int [not null, ref: > student.student_id]
  booking_id int
  booking_discipline_event_type varchar(30) [not null, ref: > discipline_event_type_category.code, note: 'ประเภทเหตุวินัย (FK -> discipline_event_type_category)']
  booking_discipline_delta_score int
  booking_discipline_delta_points int
  booking_discipline_lock_until timestamptz
  booking_discipline_note text
  booking_discipline_created_by_id int [ref: > account.account_id]
  booking_discipline_created_at timestamptz [default: `now()`]

  Note: 'บันทึกวินัย (โทษยกเลิกสาย/ไม่มา/ปลดล็อค)'
}


// =====================
// FEEDBACK
// =====================

Table feedback {
  feedback_id int [pk, increment]
  university_id int [not null]
  booking_id int [not null]
  student_id int [not null]
  consultant_id int [not null]
  consultant_university_id int [not null]
  feedback_is_anonymous boolean [default: true]
  feedback_created_at timestamp [default: `now()`]


  Note: 'Feedback ต่อ booking (1:1)'
}

Table evaluation_criterion {
  evaluation_criterion_id int [pk, increment]
  evaluation_criterion_topic_th varchar(100) [not null]
  evaluation_criterion_topic_en varchar(100)
  evaluation_criterion_weight decimal(3,2) [default: 1.00]
  evaluation_criterion_display_order int [default: 0]

  Note: 'เกณฑ์ประเมิน consultant'
}

Table feedback_rating {
  feedback_rating_id int [pk, increment]
  feedback_id int [not null, ref: > feedback.feedback_id]
  evaluation_criterion_id int [not null, ref: > evaluation_criterion.evaluation_criterion_id]
  feedback_rating_score int [not null]


  Note: 'คะแนนประเมิน (each criterion per feedback)'
}

Table feedback_comment {
  feedback_id int [pk, ref: - feedback.feedback_id]
  feedback_comment_text text
  feedback_comment_admin_reply text
  feedback_comment_replied_by_id int [ref: > account.account_id]
  feedback_comment_replied_at timestamp

  Note: 'ความคิดเห็นเพิ่มเติม + admin reply (1:1 with feedback)'
}


// =====================
// NOTIFICATION (In-Web)
// =====================

Table notification_template {
  notification_template_id int [pk, increment]
  notification_template_code varchar(50) [unique, not null]
  notification_template_title varchar(200)
  notification_template_body text
  notification_template_icon varchar(30) [default: 'BELL', note: 'BELL, BOOKING, ALERT, INFO, ASSIGN, REWARD']
  notification_template_category varchar(30) [default: 'SYSTEM', note: 'SYSTEM, BOOKING, ALERT, ASSIGNMENT, REWARD']

  Note: 'Template แจ้งเตือนในเว็บ'
}

Table notification {
  notification_id int [pk, increment]
  account_id int [not null, ref: > account.account_id]
  notification_template_id int [not null, ref: > notification_template.notification_template_id]
  university_id int
  booking_id int
  notification_title varchar(200)
  notification_body text
  notification_channel varchar(20) [default: 'WEB']
  notification_data json
  notification_read_at timestamp [note: 'null=ยังไม่อ่าน']
  notification_created_at timestamp [default: `now()`]

  Note: 'รายการแจ้งเตือนในเว็บ (กระดิ่ง 🔔)'
}


// =====================
// POINTS (สะสมแต้ม)
// =====================

Table point_rule {
  point_rule_id int [pk, increment]
  point_rule_code varchar(50) [unique, not null]
  point_rule_name_th varchar(200) [not null]
  point_rule_points int [not null]
  point_rule_is_active boolean [default: true]
  point_rule_created_at timestamp [default: `now()`]

  Note: 'กฎการให้แต้ม'
}

Table student_point_wallet {
  student_id int [not null]
  university_id int [not null]
  student_point_balance int [default: 0]


  Note: 'กระเป๋าแต้มนิสิต (1:1 per university)'
}

Table student_point_transaction {
  student_point_transaction_id int [pk, increment]
  student_id int [not null, ref: > student.student_id]
  point_rule_id int [ref: > point_rule.point_rule_id]
  booking_university_id int
  booking_id int
  student_point_txn_type varchar(30) [not null, ref: > point_txn_type_category.code, note: 'ประเภทธุรกรรม (FK -> point_txn_type_category)']
  student_point_amount int [not null]
  student_point_note text
  student_point_created_at timestamp [default: `now()`]

  Note: 'ธุรกรรมแต้ม (EARN/REDEEM/ADJUST/EXPIRE)'
}


// =====================
// AI KNOWLEDGE BASE
// =====================

Table ai_kb_document {
  ai_kb_document_id int [pk, increment]
  university_id int [ref: > university.university_id]
  ai_kb_document_key varchar(120) [not null]
  ai_kb_document_title varchar(200) [not null]
  ai_kb_document_category varchar(50)
  ai_kb_document_url_hint varchar(200)
  ai_kb_document_is_active boolean [default: true]
  ai_kb_published_version_id int
  ai_kb_document_created_at timestamptz [default: `now()`]
  ai_kb_document_updated_at timestamptz [default: `now()`]


  Note: 'เอกสาร KB สำหรับ AI chatbot (กลาง/ของแต่ละมหาลัย)'
}

Table ai_kb_document_role {
  ai_kb_document_id int [not null, ref: > ai_kb_document.ai_kb_document_id]
  ai_actor_role varchar(30) [not null]


  Note: 'สิทธิ์เข้าถึง KB document ตาม role'
}

Table ai_kb_document_version {
  ai_kb_document_version_id int [pk, increment]
  ai_kb_document_id int [not null, ref: > ai_kb_document.ai_kb_document_id]
  ai_kb_version_no int [not null]
  ai_kb_content_type varchar(30) [not null, ref: > kb_content_type_category.code, note: 'ประเภทเนื้อหา (FK -> kb_content_type_category)']
  ai_kb_version_status KbVersionStatus [default: 'DRAFT']
  ai_kb_source_path text
  ai_kb_source_md text
  ai_kb_source_json json
  ai_kb_normalized_text text
  ai_kb_index_status KbIndexStatus [default: 'PENDING']
  ai_kb_index_error text
  ai_kb_version_created_at timestamptz [default: `now()`]
  ai_kb_version_updated_at timestamptz [default: `now()`]


  Note: 'เวอร์ชันเนื้อหา KB (draft/published/archived)'
}

Table ai_kb_chunk {
  ai_kb_chunk_id int [pk, increment]
  ai_kb_document_id int [not null, ref: > ai_kb_document.ai_kb_document_id]
  ai_kb_document_version_id int [not null, ref: > ai_kb_document_version.ai_kb_document_version_id]
  ai_kb_chunk_index int [not null]
  ai_kb_chunk_content_text text [not null]
  ai_kb_chunk_embedding json
  ai_kb_chunk_token_count int
  university_id int [ref: > university.university_id]
  ai_kb_chunk_created_at timestamptz [default: `now()`]


  Note: 'ชิ้นส่วน KB สำหรับ RAG (vector search)'
}

Table ai_feedback_event {
  ai_feedback_event_id int [pk, increment]
  university_id int [ref: > university.university_id]
  account_id int [ref: > account.account_id]
  ai_user_role varchar(30)
  ai_feedback_type varchar(30) [not null, ref: > ai_feedback_type_category.code, note: 'ประเภท feedback (FK -> ai_feedback_type_category)']
  ai_user_question_text text [not null]
  ai_assistant_reply_excerpt varchar(500)
  ai_feedback_status AiFeedbackStatus [default: 'OPEN']
  ai_resolved_document_id int [ref: > ai_kb_document.ai_kb_document_id]
  ai_created_at timestamptz [default: `now()`]

  Note: 'เคส feedback AI ที่ตอบไม่ได้/ผิด/ถูกบล็อก'
}


// =====================
// BORROW (ระบบยืมที่ปรึกษา)
// =====================

Table borrow_request {
  borrow_request_id int [pk, increment]
  from_university_id int [not null, ref: > university.university_id]
  requested_by_account_id int [not null, ref: > account.account_id]
  borrow_request_title varchar(200) [not null]
  borrow_request_reason text [not null]
  borrow_request_detail text
  borrow_needed_from timestamptz
  borrow_needed_to timestamptz
  borrow_needed_count int [default: 1]
  borrow_request_status BorrowRequestStatus [default: 'DRAFT']
  borrow_submitted_at timestamptz
  borrow_submitted_by_account_id int [ref: > account.account_id]
  borrow_submit_note text
  borrow_approved_at timestamptz
  borrow_approved_by_account_id int [ref: > account.account_id]
  borrow_rejected_at timestamptz
  borrow_rejected_by_account_id int [ref: > account.account_id]
  borrow_reject_reason text
  borrow_request_created_at timestamptz [default: `now()`]
  borrow_request_updated_at timestamptz [default: `now()`]

  Note: 'คำขอยืมที่ปรึกษาข้ามมหาวิทยาลัย'
}

Table borrow_assignment {
  borrow_assignment_id int [pk, increment]
  borrow_request_id int [not null, ref: > borrow_request.borrow_request_id]
  consultant_id int [not null, ref: > consultant.consultant_id]
  consultant_university_id int [not null, ref: > university.university_id]
  borrow_assign_start_at timestamptz [not null]
  borrow_assign_end_at timestamptz [not null]
  borrow_assigned_by_account_id int [not null, ref: > account.account_id]
  borrow_assignment_note text
  borrow_assigned_at timestamptz [default: `now()`]


  Note: 'การมอบหมาย consultant ยืมตัว (1 request -> many assignments)'
}

Table consultant_borrow_availability {
  consultant_borrow_availability_id int [pk, increment]
  borrow_plan_id uuid [not null]
  consultant_id int [not null, ref: > consultant.consultant_id]
  home_university_id int [not null, ref: > university.university_id]
  target_university_id int [not null, ref: > university.university_id]
  borrow_assignment_id int [ref: > borrow_assignment.borrow_assignment_id]
  availability_start_date date [not null]
  availability_end_date date [not null]
  status BorrowAvailabilityStatus [default: 'ACTIVE']
  note text
  created_by_account_id int [ref: > account.account_id]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  completed_at timestamptz

  Note: 'ตารางว่างของที่ปรึกษาที่ถูกยืม'
}

Table consultant_borrow_policy {
  consultant_borrow_policy_id int [pk, increment]
  university_id int [ref: > university.university_id]
  borrow_window_days int [default: 14]
  is_active boolean [default: true]
  created_at timestamptz [default: `now()`]

  Note: 'นโยบายหน้าต่างยืมตัว (วันที่อนุญาต) — null = global default'
}


// =====================
// GUIDEBOOK
// =====================

Table guidebook_document {
  document_id int [pk, increment]
  document_slug varchar(100) [unique, not null]
  document_title varchar(200) [not null]
  document_content text [not null]
  document_is_active boolean [default: true]
  document_order int [default: 0]
  document_created_at timestamp [default: `now()`]
  document_updated_at timestamp

  Note: 'เอกสารคู่มือ/ข้อมูลทั่วไป'
}


// =====================================================
// ADDITIONAL FK REFS (เส้นเชื่อมที่ไม่ได้ใส่ inline)
// =====================================================

// --- Booking ---
Ref: booking.student_id > student.student_id
Ref: booking.time_slot_id > time_slot.time_slot_id

// --- Booking Session -> Booking ---
Ref: booking_session.booking_id > booking.booking_id

// --- Booking Assignment -> Booking ---
Ref: booking_assignment.booking_id > booking.booking_id
Ref: booking_assignment.consultant_id > consultant.consultant_id

// --- Booking Outcome -> Booking ---
Ref: booking_outcome.booking_id > booking.booking_id

// --- Booking Agreement Signature ---
Ref: booking_agreement_signature.booking_id > booking.booking_id
Ref: booking_agreement_signature.student_id > student.student_id

// --- Booking Cancellation -> Booking ---
Ref: booking_cancellation.booking_id > booking.booking_id

// --- Booking Attendance -> Booking ---
Ref: booking_attendance.booking_id > booking.booking_id

// --- Booking Exception Request ---
Ref: booking_exception_request.booking_id > booking.booking_id
Ref: booking_exception_request.student_id > student.student_id

// --- Feedback ---
Ref: feedback.booking_id > booking.booking_id
Ref: feedback.student_id > student.student_id
Ref: feedback.consultant_id > consultant.consultant_id

// --- Notification -> Booking ---
Ref: notification.booking_id > booking.booking_id

// --- Student Point Transaction -> Booking ---
Ref: student_point_transaction.booking_id > booking.booking_id

// --- Booking Punishment Log -> Booking ---
Ref: booking_punishment_log.booking_id > booking.booking_id

// --- Student Point Wallet -> Student ---
Ref: student_point_wallet.student_id > student.student_id


// --- Student Address -> Student ---
Ref: student_address.student_id > student.student_id

// --- Student Academic -> Student/Faculty/Department ---
Ref: student_academic.student_id > student.student_id
Ref: student_academic.faculty_id > faculty.faculty_id
Ref: student_academic.department_id > department.department_id

// --- Student Chronic Condition -> Student Profile ---
Ref: student_chronic_condition.student_id > student_profile.student_id

// --- Student Behavior Status -> Student ---
Ref: student_behavior_status.student_id > student.student_id

// --- Department -> Faculty ---
Ref: department.faculty_id > faculty.faculty_id

// --- Advisor -> Faculty/Department ---
Ref: advisor.faculty_id > faculty.faculty_id
Ref: advisor.department_id > department.department_id

// --- AI KB Document -> Published Version ---
Ref: ai_kb_document.ai_kb_published_version_id > ai_kb_document_version.ai_kb_document_version_id
