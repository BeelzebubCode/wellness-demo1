// University Network Connections (for proximity visualization)
model UniversityConnection {
  connection_id         Int      @id @default(autoincrement())
  source_university_id  Int
  target_university_id  Int
  distance_km           Decimal  @db.Decimal(8, 2)
  connection_rank       Int // 1 = closest, 2 = 2nd closest, 3 = 3rd closest
  connection_created_at DateTime @default(now())

  sourceUniversity University @relation("SourceUniversity", fields: [source_university_id], references: [university_id], onDelete: Cascade)
  targetUniversity University @relation("TargetUniversity", fields: [target_university_id], references: [university_id], onDelete: Cascade)

  @@unique([source_university_id, target_university_id])
  @@index([source_university_id])
  @@index([target_university_id])
  @@map("university_connection")
}

