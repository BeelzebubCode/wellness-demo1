model CancellationReason {
  cancellation_reason_id          Int     @id @default(autoincrement())
  cancellation_reason_code        String  @unique @db.VarChar(20)
  cancellation_reason_name_th     String  @db.VarChar(100)
  cancellation_reason_name_en     String? @db.VarChar(100)
  cancellation_reason_description String? @db.Text

  bookingCancellations BookingCancellation[]

  @@map("cancellation_reason")
