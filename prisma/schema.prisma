// ==========================================
// 📅 ACADEMIC TERM (เทอมของแต่ละ ม.)
// ==========================================

model AcademicTerm {
  academic_term_id      Int      @id @default(autoincrement())
  university_id         Int
  academic_term_type_id Int
  academic_year         Int
  term_start_date       DateTime @db.Date
  term_end_date         DateTime @db.Date
  is_active             Boolean  @default(false)

  university       University       @relation(fields: [university_id], references: [university_id])
  academicTermType AcademicTermType @relation(fields: [academic_term_type_id], references: [academic_term_type_id])
  periods          AcademicPeriod[]
  bookings         Booking[]

  @@unique([university_id, academic_term_type_id, academic_year])
  @@index([university_id, is_active])
  @@index([academic_term_type_id])
  @@map("academic_term")
}

// ==========================================
// 📅 ACADEMIC PERIOD (ช่วงย่อยในเทอม)
