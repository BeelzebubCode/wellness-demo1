generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Region {
  region_id      Int        @id @default(autoincrement())
  region_code    String     @unique @db.VarChar(30)
  region_name_th String     @db.VarChar(50)
  region_name_en String?    @db.VarChar(50)
  provinces      Province[]

  @@map("region")
}

model Province {
  province_id      Int     @id @default(autoincrement())
  region_id        Int
  province_code    String  @unique @db.VarChar(10)
  province_name_th String  @db.VarChar(100)
  province_name_en String? @db.VarChar(100)
  is_special_zone  Boolean @default(false)

  region           Region           @relation(fields: [region_id], references: [region_id])
  studentAddresses StudentAddress[]
  universities     University[]

  @@index([region_id])
  @@map("province")
}

model University {
  university_id         Int      @id @default(autoincrement())
  university_code       String   @unique @db.VarChar(20)
  university_name_th    String   @db.VarChar(200)
  university_name_en    String?  @db.VarChar(200)
  province_id           Int
  university_is_active  Boolean  @default(true)
  university_created_at DateTime @default(now())
  university_type_id    Int?

  rector_account_id Int?
  rector            Account? @relation("UniversityRector", fields: [rector_account_id], references: [account_id])

  province             Province                @relation(fields: [province_id], references: [province_id])
  universityType       UniversityTypeCategory? @relation(fields: [university_type_id], references: [university_type_id])
  university_latitude  Decimal?                @db.Decimal(9, 6)
  university_longitude Decimal?                @db.Decimal(9, 6)

  accountsHome      Account[]                     @relation("AccountHomeUniversity")
  accessPermissions AccountUniversityPermission[]
  students          Student[]
  consultants       Consultant[]
  faculties         Faculty[]
  departments       Department[]
  advisors          Advisor[]
  timeSlots         TimeSlot[]
  bookings          Booking[]
  shiftTeams        ConsultantShiftTeam[]

  aiKbDocuments    AiKbDocument[]    @relation("UniversityAiKbDocuments")
  aiKbChunks       AiKbChunk[]       @relation("UniversityAiKbChunks")
  aiFeedbackEvents AiFeedbackEvent[] @relation("UniversityAiFeedbackEvents")

  borrowRequestsFrom BorrowRequest[]

  consultantBorrowPolicies ConsultantBorrowPolicy[]
  BookingAssignment        BookingAssignment[]

  connectionsFrom UniversityConnection[] @relation("SourceUniversity")
  connectionsTo   UniversityConnection[] @relation("TargetUniversity")

  homeBorrowAvailabilities   ConsultantBorrowAvailability[] @relation("BorrowAvailabilityHomeUniversity")
  targetBorrowAvailabilities ConsultantBorrowAvailability[] @relation("BorrowAvailabilityTargetUniversity")
  borrowAssignments          BorrowAssignment[]
  dayPeriods                 DayPeriod[]                    @relation("UniversityDayPeriods")
  academicTerms              AcademicTerm[]
  academicPeriods            AcademicPeriod[]
  disciplineLogs             DisciplineLog[]

  @@index([province_id])
  @@index([university_is_active])
  @@index([university_type_id])
  @@map("university")
}

model AccountUniversityPermission {
  account_university_permission_id Int       @id @default(autoincrement())
  account_id                       Int
  university_id                    Int
  access_role                      String    @default("STUDENT") @db.VarChar(30)
  access_granted_by_account_id     Int?
  access_granted_at                DateTime  @default(now())
  access_revoked_at                DateTime?

  account          Account    @relation(fields: [account_id], references: [account_id])
  university       University @relation(fields: [university_id], references: [university_id])
  grantedByAccount Account?   @relation("AccessGrantedBy", fields: [access_granted_by_account_id], references: [account_id])

  @@unique([account_id, university_id])
  @@index([university_id])
  @@index([access_role])
  @@index([access_granted_by_account_id])
  @@map("account_university_permission")
}

// ==========================================
// 👤 ACCOUNT
// ==========================================

model Account {
  account_id                 Int       @id @default(autoincrement())
  account_username           String    @unique @db.VarChar(50)
  account_password           String    @db.VarChar(255)
  account_role_id            Int // ✅ FK → AccountRoleCategory
  account_home_university_id Int?
  account_created_at         DateTime  @default(now())
  account_last_login_at      DateTime?

  roleCategory          AccountRoleCategory           @relation(fields: [account_role_id], references: [account_role_id])
  homeUniversity        University?                   @relation("AccountHomeUniversity", fields: [account_home_university_id], references: [university_id])
  accessPermissions     AccountUniversityPermission[]
  accessGrantedToOthers AccountUniversityPermission[] @relation("AccessGrantedBy")

  bookingCancellations   BookingCancellation[]
  consultant             Consultant?
  advisor                Advisor?
  feedbackCommentReplies FeedbackComment[]     @relation("FeedbackCommentRepliedBy")
  notifications          Notification[]
  student                Student?
  aiFeedbackEvents       AiFeedbackEvent[]
  facultiesDean          Faculty[]             @relation("FacultyDean")
  departmentsHead        Department[]          @relation("DepartmentHead")
  rectorOfUniversities   University[]          @relation("UniversityRector")

  borrowRequestsRequested BorrowRequest[] @relation("BorrowRequestedBy")
  borrowRequestsSubmitted BorrowRequest[] @relation("BorrowSubmittedBy")
  borrowRequestsApproved  BorrowRequest[] @relation("BorrowApprovedBy")
  borrowRequestsRejected  BorrowRequest[] @relation("BorrowRejectedBy")

  borrowAssignmentsMade BorrowAssignment[]  @relation("BorrowAssignedBy")
  BookingAssignment     BookingAssignment[]

  BookingSession BookingSession[]

  borrowAvailabilities     ConsultantBorrowAvailability[]
  bookingAttendances       BookingAttendance[]            @relation("AttendanceMarkedBy")
  bookingExceptionRequests BookingExceptionRequest[]      @relation("ExceptionReviewedBy")
  disciplineLogsCreated    DisciplineLog[]                @relation("DisciplineCreatedBy")

  @@index([account_role_id])
  @@index([account_home_university_id])
  @@map("account")
}

// ==========================================
// 🎓 STUDENT
// ==========================================

model Student {
  student_id        Int     @id @default(autoincrement())
  account_id        Int     @unique
  university_id     Int
  student_status_id Int
  student_code      String? @db.VarChar(20)

  bookings   Booking[]
  feedbacks  Feedback[]
  account    Account          @relation(fields: [account_id], references: [account_id])
  university University       @relation(fields: [university_id], references: [university_id])
  status     StudentStatus    @relation(fields: [student_status_id], references: [student_status_id])
  academic   StudentAcademic?
  addresses  StudentAddress[]
  profile    StudentProfile?

  pointWallet         StudentPointWallet?
  pointTransactions   StudentPointTransaction[]
  agreementSignatures BookingAgreementSignature[]

  // Exception & Attendance
  behaviorStatus    StudentBehaviorStatus?
  exceptionRequests BookingExceptionRequest[]
  disciplineLogs    DisciplineLog[]

  @@unique([university_id, student_id])
  @@unique([university_id, student_code])
  @@index([student_status_id])
  @@index([university_id])
  @@map("student")
}

model StudentStatus {
  student_status_id     Int       @id @default(autoincrement())
  student_status_code   String    @unique @db.VarChar(20)
  student_status_detail String?   @db.Text
  students              Student[]

  @@map("student_status")
}

model StudentProfile {
  student_id            Int     @id
  university_id         Int
  student_prefix        String? @db.VarChar(10)
  student_first_name_th String  @db.VarChar(100)
  student_last_name_th  String  @db.VarChar(100)
  student_nickname_th   String? @db.VarChar(20)

  student_first_name_en String? @db.VarChar(100)
  student_last_name_en  String? @db.VarChar(100)
  student_nickname_en   String? @db.VarChar(20)

  gender_category_id   Int?
  student_birthday     DateTime? @db.Date
  student_nationality  String?   @db.VarChar(50)
  student_religion     String?   @db.VarChar(50)
  blood_group_id       Int?
  student_phone_number String?   @db.VarChar(20)
  student_email        String?   @db.VarChar(100)
  country_id           Int?

  // Family info
  sibling_count      Int?
  birth_order        Int?
  income_bracket_id  Int?
  parental_status_id Int?

  student           Student                   @relation(fields: [university_id, student_id], references: [university_id, student_id])
  country           Country?                  @relation(fields: [country_id], references: [country_id])
  genderCategory    GenderCategory?           @relation(fields: [gender_category_id], references: [gender_category_id])
  bloodGroup        BloodGroupCategory?       @relation(fields: [blood_group_id], references: [blood_group_id])
  incomeBracket     IncomeBracketCategory?    @relation(fields: [income_bracket_id], references: [income_bracket_id])
  parentalStatus    ParentalStatusCategory?   @relation(fields: [parental_status_id], references: [parental_status_id])
  chronicConditions StudentChronicCondition[]

  @@unique([university_id, student_id])
  @@index([country_id])
  @@index([gender_category_id])
  @@index([blood_group_id])
  @@index([income_bracket_id])
  @@index([parental_status_id])
  @@map("student_profile")
}

model StudentAddress {
  student_address_id           Int                 @id @default(autoincrement())
  student_id                   Int
  university_id                Int
  province_id                  Int
  address_type_id              Int
  student_address_detail       String?             @db.VarChar(200)
  student_address_sub_district String?             @db.VarChar(100)
  student_address_district     String?             @db.VarChar(100)
  student_address_postal_code  String              @db.VarChar(10)
  province                     Province            @relation(fields: [province_id], references: [province_id])
  student                      Student             @relation(fields: [university_id, student_id], references: [university_id, student_id])
  addressType                  AddressTypeCategory @relation(fields: [address_type_id], references: [address_type_id])

  @@unique([university_id, student_id, address_type_id])
  @@index([university_id, student_id])
  @@map("student_address")
}

model StudentAcademic {
  student_id    Int  @id
  university_id Int
  faculty_id    Int
  department_id Int
  advisor_id    Int?

  student_program             String? @db.VarChar(50)
  student_degree              String? @db.VarChar(50)
  student_degree_name         String? @db.VarChar(100)
  student_admit_academic_year Int?
  education_level_id          Int?
  program_duration_years      Int?
  expected_graduation_year    Int?

  student        Student                 @relation(fields: [university_id, student_id], references: [university_id, student_id])
  faculty        Faculty                 @relation(fields: [university_id, faculty_id], references: [university_id, faculty_id])
  department     Department              @relation(fields: [university_id, department_id], references: [university_id, department_id])
  advisor        Advisor?                @relation(fields: [advisor_id], references: [advisor_id])
  educationLevel EducationLevelCategory? @relation(fields: [education_level_id], references: [education_level_id])

  @@unique([university_id, student_id])
  @@index([university_id, faculty_id])
  @@index([university_id, department_id])
  @@index([advisor_id])
  @@index([education_level_id])
  @@map("student_academic")
}

// ==========================================
// 🏢 FACULTY & DEPARTMENT (ผูกมหาลัย) AcademicGroup
// ==========================================

model SubjectGroupCategory {
  subject_group_category_id Int    @id @default(autoincrement())
  isced_broad_field_code    String @unique @db.VarChar(2) // "00".."10"
  field_group_name_th       String @db.VarChar(150)
  field_group_name_en       String @db.VarChar(150)

  faculties Faculty[]

  @@map("subject_group_category")
}

model Faculty {
  faculty_id      Int     @id @default(autoincrement())
  university_id   Int
  faculty_code    String  @db.VarChar(10)
  faculty_name_th String  @db.VarChar(100)
  faculty_name_en String? @db.VarChar(100)

  dean_account_id Int? // [NEW] Link to Dean account

  subject_group_category_id Int?
  subjectGroupCategory      SubjectGroupCategory? @relation(fields: [subject_group_category_id], references: [subject_group_category_id])

  university University @relation(fields: [university_id], references: [university_id])
  dean       Account?   @relation("FacultyDean", fields: [dean_account_id], references: [account_id])

  advisors         Advisor[]
  departments      Department[]
  studentAcademics StudentAcademic[]

  @@unique([university_id, faculty_id])
  @@unique([university_id, faculty_code])
  @@index([university_id])
  @@index([subject_group_category_id])
  @@index([dean_account_id])
  @@map("faculty")
}

model Department {
  department_id      Int     @id @default(autoincrement())
  university_id      Int
  faculty_id         Int
  head_account_id    Int? // [NEW] Link to Head Department account
  department_code    String  @db.VarChar(10)
  department_name_th String  @db.VarChar(100)
  department_name_en String? @db.VarChar(100)

  university University @relation(fields: [university_id], references: [university_id])
  faculty    Faculty    @relation(fields: [university_id, faculty_id], references: [university_id, faculty_id])
  head       Account?   @relation("DepartmentHead", fields: [head_account_id], references: [account_id])

  advisors         Advisor[]
  studentAcademics StudentAcademic[]

  @@unique([university_id, department_id])
  @@unique([university_id, department_code])
  @@index([faculty_id])
  @@index([university_id, faculty_id])
  @@index([university_id])
  @@index([head_account_id])
  @@map("department")
}

// ==========================================
// 🎓 ADVISOR (ผูกมหาลัย)
// ==========================================

model Advisor {
  advisor_id              Int     @id @default(autoincrement())
  university_id           Int
  faculty_id              Int
  department_id           Int
  advisor_academic_rank   String? @db.VarChar(50)
  advisor_prefix          String? @db.VarChar(50)
  advisor_first_name      String  @db.VarChar(100)
  advisor_last_name       String  @db.VarChar(100)
  advisor_email           String? @unique @db.VarChar(100)
  advisor_phone_number    String? @db.VarChar(50)
  advisor_office_location String? @db.VarChar(100)

  // [NEW] Account Relation
  account_id Int?     @unique // Optional initially to avoid migration issues with existing data, but logically should be required later
  account    Account? @relation(fields: [account_id], references: [account_id])

  university       University        @relation(fields: [university_id], references: [university_id])
  faculty          Faculty           @relation(fields: [university_id, faculty_id], references: [university_id, faculty_id])
  department       Department        @relation(fields: [university_id, department_id], references: [university_id, department_id])
  studentAcademics StudentAcademic[]

  @@index([university_id])
  @@index([university_id, faculty_id])
  @@index([university_id, department_id])
  @@map("advisor")
}

// ==========================================
// 🧠 CONSULTANT (ผูกมหาลัย)
// ==========================================

model Consultant {
  consultant_id         Int      @id @default(autoincrement())
  account_id            Int      @unique
  university_id         Int
  organization_id       Int
  shift_team_id         Int?
  consultant_created_at DateTime @default(now())

  bookings Booking[]

  account      Account              @relation(fields: [account_id], references: [account_id])
  university   University           @relation(fields: [university_id], references: [university_id])
  organization Organization         @relation(fields: [organization_id], references: [organization_id])
  shiftTeam    ConsultantShiftTeam? @relation(fields: [shift_team_id], references: [shift_team_id])

  languages         ConsultantLanguage[]
  profile           ConsultantProfile?
  specializations   ConsultantSpecialization[]
  feedbacks         Feedback[]
  borrowAssignments BorrowAssignment[]

  BookingAssignment    BookingAssignment[]
  borrowAvailabilities ConsultantBorrowAvailability[]

  @@unique([university_id, consultant_id])
  @@index([organization_id])
  @@index([university_id])
  @@index([shift_team_id])
  @@map("consultant")
}

model ConsultantProfile {
  consultant_id           Int        @id
  consultant_prefix       String?    @db.VarChar(50)
  consultant_first_name   String     @db.VarChar(100)
  consultant_last_name    String     @db.VarChar(100)
  consultant_nickname     String?    @db.VarChar(50)
  consultant_gender       String?    @db.VarChar(20)
  consultant_nationality  String?    @db.VarChar(50)
  consultant_phone_number String?    @db.VarChar(20)
  consultant_email        String?    @db.VarChar(100)
  consultant              Consultant @relation(fields: [consultant_id], references: [consultant_id])

  @@map("consultant_profile")
}

model ConsultantLanguage {
  consultant_language_id            Int        @id @default(autoincrement())
  consultant_id                     Int
  consultant_language_code          String     @db.VarChar(10)
  consultant_language_fluency_level String?    @db.VarChar(20)
  consultant                        Consultant @relation(fields: [consultant_id], references: [consultant_id])

  @@unique([consultant_id, consultant_language_code])
  @@map("consultant_language")
}

model ConsultantSpecialization {
  consultant_specialization_id    Int        @id @default(autoincrement())
  consultant_id                   Int
  consultant_specialization_topic String     @db.VarChar(100)
  consultant                      Consultant @relation(fields: [consultant_id], references: [consultant_id])

  @@unique([consultant_id, consultant_specialization_topic])
  @@map("consultant_specialization")
}

model Organization {
  organization_id   Int          @id @default(autoincrement())
  organization_name String       @unique @db.VarChar(100)
  organization_type String?      @db.VarChar(50)
  consultants       Consultant[]

  @@map("organization")
}

// ==========================================
// 🛡️ CONSULTANT SHIFT TEAM (ผูกมหาลัย)
// ==========================================
model ConsultantShiftTeam {
  shift_team_id Int    @id @default(autoincrement())
  university_id Int
  team_name     String @db.VarChar(50) // e.g. "ทีม 1"
  team_order    Int    @default(1) // 1, 2, 3, 4

  consultants Consultant[]
  university  University   @relation(fields: [university_id], references: [university_id])

  @@unique([university_id, team_name])
  @@unique([university_id, team_order])
  @@map("consultant_shift_team")
}

// ==========================================
// ⏰ TIME SLOT (ผูก consultant + university)
// ==========================================

model TimeSlot {
  time_slot_id             Int            @id @default(autoincrement())
  university_id            Int
  time_slot_start_datetime DateTime       @db.Timestamptz(3)
  time_slot_end_datetime   DateTime       @db.Timestamptz(3)
  time_slot_max_capacity   Int            @default(1)
  time_slot_status         TimeSlotStatus @default(OPEN)

  university University @relation(fields: [university_id], references: [university_id])
  bookings   Booking[]

  day_period_id Int?
  dayPeriod     DayPeriod? @relation(fields: [day_period_id], references: [day_period_id])

  @@unique([university_id, time_slot_id])
  @@unique([university_id, time_slot_start_datetime, time_slot_end_datetime])
  @@index([university_id, time_slot_start_datetime])
  @@index([university_id, day_period_id, time_slot_start_datetime])
  @@map("time_slot")
}

model DayPeriod {
  day_period_id Int @id @default(autoincrement())

  university_id Int?

  day_period_code    String  @db.VarChar(30)
  day_period_name_th String  @db.VarChar(50)
  day_period_name_en String? @db.VarChar(50)

  start_time DateTime @db.Time
  end_time   DateTime @db.Time

  spans_midnight Boolean @default(false)

  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  university University? @relation("UniversityDayPeriods", fields: [university_id], references: [university_id])

  timeSlots TimeSlot[]

  @@unique([university_id, day_period_code])
  @@index([university_id, is_active])
  @@map("day_period")
}

// ==========================================
// 📅 ONLINE CHANNEL
// ==========================================

model OnlineChannelCategory {
  online_channel_category_id Int     @id @default(autoincrement())
  online_channel_code        String  @unique @db.VarChar(50) // LINE_CALL, GOOGLE_MEET, etc.
  online_channel_name_th     String  @db.VarChar(100)
  online_channel_name_en     String? @db.VarChar(100)
  online_channel_icon_key    String? @db.VarChar(50) // e.g. "line", "meet", "zoom", "teams", "phone"
  is_active                  Boolean @default(true)

  bookings        Booking[]
  bookingSessions BookingSession[]

  @@map("online_channel_category")
}

// ==========================================
// 📅 BOOKING 
// ==========================================
model Booking {
  booking_id          Int  @default(autoincrement())
  university_id       Int
  student_id          Int
  consultant_id       Int?
  time_slot_id        Int
  problem_category_id Int

  service_mode_id            Int
  online_channel_category_id Int? // [NEW] Link to OnlineChannelCategory

  season_id        Int?
  academic_term_id Int?

  booking_detail_text String?       @db.Text
  booking_status      BookingStatus @default(PENDING_ASSIGNMENT)
  booking_created_at  DateTime      @default(now())
  booking_updated_at  DateTime      @default(now()) @updatedAt

  university University  @relation(fields: [university_id], references: [university_id])
  student    Student     @relation(fields: [university_id, student_id], references: [university_id, student_id])
  consultant Consultant? @relation(fields: [consultant_id], references: [consultant_id])

  timeSlot        TimeSlot               @relation(fields: [university_id, time_slot_id], references: [university_id, time_slot_id])
  problemCategory ProblemCategory        @relation(fields: [problem_category_id], references: [problem_category_id])
  onlineChannel   OnlineChannelCategory? @relation(fields: [online_channel_category_id], references: [online_channel_category_id])
  season          Season?                @relation(fields: [season_id], references: [season_id])
  academicTerm    AcademicTerm?          @relation(fields: [academic_term_id], references: [academic_term_id])
  serviceMode     ServiceModeCategory    @relation(fields: [service_mode_id], references: [service_mode_id])

  assignments        BookingAssignment[]
  cancellation       BookingCancellation?
  outcome            BookingOutcome?
  feedback           Feedback?
  notifications      Notification[]
  pointTransactions  StudentPointTransaction[]  @relation("BookingPointTx")
  agreementSignature BookingAgreementSignature?
  BookingSession     BookingSession?

  // Exception & Attendance
  attendance       BookingAttendance?
  exceptionRequest BookingExceptionRequest?
  disciplineLogs   DisciplineLog[]

  @@id([university_id, booking_id])
  @@index([university_id, time_slot_id])
  @@index([booking_status])
  @@index([student_id])
  @@index([consultant_id])
  @@index([problem_category_id])
  @@index([university_id, problem_category_id])
  @@index([student_id, booking_status])
  @@index([university_id, time_slot_id, booking_status])
  @@index([booking_status, university_id, student_id])
  @@index([season_id])
  @@index([academic_term_id])
  @@index([service_mode_id])
  @@map("booking")
}

model BookingSession {
  booking_session_id Int @id @default(autoincrement())

  university_id Int
  booking_id    Int

  // ✅ ยืนยันตามที่รับเคสจริง (ส่วนใหญ่จะ = booking_service_mode แต่เผื่อเปลี่ยนได้)
  service_mode_id            Int
  online_channel_category_id Int?

  // ✅ สิ่งที่ consultant ส่งจริง
  booking_session_join_url      String? @db.Text // meet/zoom link
  booking_session_phone_number  String? @db.VarChar(30) // ถ้าเป็นโทร
  booking_session_location_text String? @db.VarChar(200) // ถ้า onsite
  booking_session_extra_detail  String? @db.Text // note เพิ่มเติม เช่น "ส่งไฟล์ในไลน์"

  // ✅ ควบคุมการแสดงลิงก์ให้นิสิต (default = true)
  booking_session_is_link_visible Boolean @default(true)

  // audit: ใครส่ง/เมื่อไหร่
  provided_by_account_id Int?
  provided_at            DateTime? @db.Timestamptz(3)

  booking       Booking                @relation(fields: [university_id, booking_id], references: [university_id, booking_id], onDelete: Cascade)
