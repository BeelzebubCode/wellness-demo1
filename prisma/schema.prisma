model AcademicPeriod {
  period_id               Int      @id @default(autoincrement())
  academic_term_id        Int
  university_id           Int
  academic_period_type_id Int
  period_name_th          String   @db.VarChar(100)
  period_name_en          String?  @db.VarChar(100)
  period_start_date       DateTime @db.Date
  period_end_date         DateTime @db.Date
  sort_order              Int      @default(0)

  term               AcademicTerm               @relation(fields: [academic_term_id], references: [academic_term_id])
  university         University                 @relation(fields: [university_id], references: [university_id])
  academicPeriodType AcademicPeriodTypeCategory @relation(fields: [academic_period_type_id], references: [academic_period_type_id])

  @@index([university_id, period_start_date, period_end_date])
  @@index([academic_term_id])
  @@map("academic_period")
}

