generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ✅ MULTI-UNIVERSITY + REGION/PROVINCE + POINTS + 1 BOOKING = 1 SLOT
// - เพิ่ม Region / Province.region_id
// - เพิ่ม University (tenant) + ผูกทุก entity ที่ต้องรู้มหาลัย
// - เพิ่ม AccountRole: RECTOR, SUPER_ADMIN
// - เพิ่ม Account.account_home_university_id
// - เพิ่ม AccountUniversityAccess (ยืมคนข้ามมหาลัย)
// - Booking.time_slot_id = UNIQUE (1 booking = 1 slot และ 1 slot ถูกจองได้ครั้งเดียว)
// - TimeSlot ผูก consultant_id + university_id
// - เพิ่มระบบสะสมแต้ม: PointRule, StudentPointWallet, StudentPointTransaction
// ==========================================

model Region {
  region_id      Int        @id @default(autoincrement())
  region_code    RegionCode @unique
  region_name_th String     @db.VarChar(50)
  region_name_en String?    @db.VarChar(50)
  provinces      Province[]

  @@map("region")
}

model Province {
  province_id      Int     @id @default(autoincrement())
  region_id        Int
  province_code    String  @unique @db.VarChar(10)
  province_name_th String  @db.VarChar(100)
  province_name_en String? @db.VarChar(100)

  region           Region           @relation(fields: [region_id], references: [region_id])
  studentAddresses StudentAddress[]
  universities     University[]

  @@index([region_id])
  @@map("province")
}

model University {
  university_id         Int      @id @default(autoincrement())
  university_code       String   @unique @db.VarChar(20)
  university_name_th    String   @db.VarChar(200)
  university_name_en    String?  @db.VarChar(200)
  province_id           Int
  university_is_active  Boolean  @default(true)
  university_created_at DateTime @default(now())

  province Province @relation(fields: [province_id], references: [province_id])

  accountsHome  Account[]                 @relation("AccountHomeUniversity")
  accessMembers AccountUniversityAccess[]
  students      Student[]
  consultants   Consultant[]
  faculties     Faculty[]
  departments   Department[]
  advisors      Advisor[]
  timeSlots     TimeSlot[]
  bookings      Booking[]

  // =========================
  // ✅ AI KB / Feedback (เพิ่มใหม่)
  // =========================
  aiKbDocuments    AiKbDocument[]    @relation("UniversityAiKbDocuments")
  aiKbChunks       AiKbChunk[]       @relation("UniversityAiKbChunks")
  aiFeedbackEvents AiFeedbackEvent[] @relation("UniversityAiFeedbackEvents")

  borrowRequestsFrom                      BorrowRequest[]
  borrowAssignmentsAsConsultantUniversity BorrowAssignment[]

  @@index([province_id])
  @@index([university_is_active])
  @@map("university")
}

model AccountUniversityAccess {
  account_university_access_id Int                  @id @default(autoincrement())
  account_id                   Int
  university_id                Int
  access_role                  UniversityAccessRole @default(STUDENT)
  access_granted_by_account_id Int?
  access_granted_at            DateTime             @default(now())
  access_revoked_at            DateTime?

  account          Account    @relation(fields: [account_id], references: [account_id])
  university       University @relation(fields: [university_id], references: [university_id])
  grantedByAccount Account?   @relation("AccessGrantedBy", fields: [access_granted_by_account_id], references: [account_id])

  @@unique([account_id, university_id])
  @@index([university_id])
  @@index([access_role])
  @@index([access_granted_by_account_id])
  @@map("account_university_access")
}

// ==========================================
// 👤 ACCOUNT
// ==========================================

model Account {
  account_id                 Int         @id @default(autoincrement())
  account_username           String      @unique @db.VarChar(50)
  account_password           String      @db.VarChar(255)
  account_role               AccountRole
  account_home_university_id Int?
  account_line_id            String?     @unique @db.VarChar(100)
  account_created_at         DateTime    @default(now())
  account_last_login_at      DateTime?

  homeUniversity        University?               @relation("AccountHomeUniversity", fields: [account_home_university_id], references: [university_id])
  universityAccesses    AccountUniversityAccess[]
  accessGrantedToOthers AccountUniversityAccess[] @relation("AccessGrantedBy")

  bookingCancellations   BookingCancellation[]
  consultant             Consultant?
  feedbackCommentReplies FeedbackComment[]     @relation("FeedbackCommentRepliedBy")
  notifications          Notification[]
  student                Student?
  aiFeedbackEvents       AiFeedbackEvent[]

  borrowRequestsRequested BorrowRequest[] @relation("BorrowRequestedBy")
  borrowRequestsSubmitted BorrowRequest[] @relation("BorrowSubmittedBy")
  borrowRequestsApproved  BorrowRequest[] @relation("BorrowApprovedBy")
  borrowRequestsRejected  BorrowRequest[] @relation("BorrowRejectedBy")

  borrowAssignmentsMade BorrowAssignment[] @relation("BorrowAssignedBy")

  @@index([account_role])
  @@index([account_home_university_id])
  @@map("account")
}

// ==========================================
// 🎓 STUDENT
// ==========================================

model Student {
  student_id        Int     @id @default(autoincrement())
  account_id        Int     @unique
  university_id     Int
  student_status_id Int
  student_code      String? @db.VarChar(20)

  bookings   Booking[]
  feedbacks  Feedback[]
  account    Account          @relation(fields: [account_id], references: [account_id])
  university University       @relation(fields: [university_id], references: [university_id])
  status     StudentStatus    @relation(fields: [student_status_id], references: [student_status_id])
  academic   StudentAcademic?
  addresses  StudentAddress[]
  profile    StudentProfile?

  pointWallet       StudentPointWallet?
  pointTransactions StudentPointTransaction[]

  @@unique([university_id, student_code])
  @@index([student_status_id])
  @@index([university_id])
  @@map("student")
}

model StudentStatus {
  student_status_id     Int       @id @default(autoincrement())
  student_status_code   String    @unique @db.VarChar(20)
  student_status_detail String?   @db.Text
  students              Student[]

  @@map("student_status")
}

model StudentProfile {
  student_id           Int            @id
  student_prefix       String?        @db.VarChar(10)
  student_first_name   String         @db.VarChar(100)
  student_last_name    String         @db.VarChar(100)
  student_nickname     String?        @db.VarChar(20)
  student_gender       StudentGender?
  student_birthday     DateTime?      @db.Date
  student_nationality  String?        @db.VarChar(50)
  student_religion     String?        @db.VarChar(50)
  student_blood_group  String?        @db.VarChar(10)
  student_phone_number String?        @db.VarChar(20)
  student_email        String?        @db.VarChar(100)
  student              Student        @relation(fields: [student_id], references: [student_id])

  @@map("student_profile")
}

model StudentAddress {
  student_address_id           Int                @id @default(autoincrement())
  student_id                   Int
  province_id                  Int
  student_address_type         StudentAddressType
  student_address_detail       String?            @db.VarChar(200)
  student_address_sub_district String?            @db.VarChar(100)
  student_address_district     String?            @db.VarChar(100)
  student_address_postal_code  String             @db.VarChar(10)
  province                     Province           @relation(fields: [province_id], references: [province_id])
  student                      Student            @relation(fields: [student_id], references: [student_id])

  @@unique([student_id, student_address_type])
  @@index([province_id])
  @@map("student_address")
}

model StudentAcademic {
  student_id                  Int        @id
  faculty_id                  Int
  department_id               Int
  advisor_id                  Int?
  student_program             String?    @db.VarChar(50)
  student_degree              String?    @db.VarChar(50)
  student_degree_name         String?    @db.VarChar(100)
  student_admit_academic_year Int?
  advisor                     Advisor?   @relation(fields: [advisor_id], references: [advisor_id])
  department                  Department @relation(fields: [department_id], references: [department_id])
  faculty                     Faculty    @relation(fields: [faculty_id], references: [faculty_id])
  student                     Student    @relation(fields: [student_id], references: [student_id])

  @@index([advisor_id])
  @@index([department_id])
  @@index([faculty_id])
  @@map("student_academic")
}

// ==========================================
// 🏢 FACULTY & DEPARTMENT (ผูกมหาลัย)
// ==========================================

model Faculty {
  faculty_id      Int     @id @default(autoincrement())
  university_id   Int
  faculty_code    String  @db.VarChar(10)
  faculty_name_th String  @db.VarChar(100)
  faculty_name_en String? @db.VarChar(100)

  university University @relation(fields: [university_id], references: [university_id])

  advisors         Advisor[]
  departments      Department[]
  studentAcademics StudentAcademic[]

  @@unique([university_id, faculty_code])
  @@index([university_id])
  @@map("faculty")
}

model Department {
  department_id      Int     @id @default(autoincrement())
  university_id      Int
  faculty_id         Int
  department_code    String  @db.VarChar(10)
  department_name_th String  @db.VarChar(100)
  department_name_en String? @db.VarChar(100)

  university       University        @relation(fields: [university_id], references: [university_id])
  advisors         Advisor[]
  faculty          Faculty           @relation(fields: [faculty_id], references: [faculty_id])
  studentAcademics StudentAcademic[]

  @@unique([university_id, department_code])
  @@index([faculty_id])
  @@index([university_id])
  @@map("department")
}

// ==========================================
// 🎓 ADVISOR (ผูกมหาลัย)
// ==========================================

model Advisor {
  advisor_id              Int     @id @default(autoincrement())
  university_id           Int
  faculty_id              Int
  department_id           Int
  advisor_academic_rank   String? @db.VarChar(50)
  advisor_prefix          String? @db.VarChar(50)
  advisor_first_name      String  @db.VarChar(100)
  advisor_last_name       String  @db.VarChar(100)
  advisor_email           String? @unique @db.VarChar(100)
  advisor_phone_number    String? @db.VarChar(50)
  advisor_office_location String? @db.VarChar(100)

  university       University        @relation(fields: [university_id], references: [university_id])
  department       Department        @relation(fields: [department_id], references: [department_id])
  faculty          Faculty           @relation(fields: [faculty_id], references: [faculty_id])
  studentAcademics StudentAcademic[]

  @@index([department_id])
  @@index([faculty_id])
  @@index([university_id])
  @@map("advisor")
}

// ==========================================
// 🧠 CONSULTANT (ผูกมหาลัย)
// ==========================================

model Consultant {
  consultant_id         Int      @id @default(autoincrement())
  account_id            Int      @unique
  university_id         Int
  organization_id       Int
  consultant_created_at DateTime @default(now())

  bookings            Booking[]
  assignmentsMade     BookingAssignment[] @relation("AssignedBy")
  assignmentsReceived BookingAssignment[] @relation("AssignedTo")

  account      Account      @relation(fields: [account_id], references: [account_id])
  university   University   @relation(fields: [university_id], references: [university_id])
  organization Organization @relation(fields: [organization_id], references: [organization_id])

  languages         ConsultantLanguage[]
  profile           ConsultantProfile?
  specializations   ConsultantSpecialization[]
  feedbacks         Feedback[]
  borrowAssignments BorrowAssignment[]

  @@index([organization_id])
  @@index([university_id])
  @@map("consultant")
}

model ConsultantProfile {
  consultant_id           Int        @id
  consultant_prefix       String?    @db.VarChar(50)
  consultant_first_name   String     @db.VarChar(100)
  consultant_last_name    String     @db.VarChar(100)
  consultant_nickname     String?    @db.VarChar(50)
  consultant_gender       String?    @db.VarChar(20)
  consultant_nationality  String?    @db.VarChar(50)
  consultant_phone_number String?    @db.VarChar(20)
  consultant_email        String?    @db.VarChar(100)
  consultant              Consultant @relation(fields: [consultant_id], references: [consultant_id])

  @@map("consultant_profile")
}

model ConsultantLanguage {
  consultant_language_id            Int        @id @default(autoincrement())
  consultant_id                     Int
  consultant_language_code          String     @db.VarChar(10)
  consultant_language_fluency_level String?    @db.VarChar(20)
  consultant                        Consultant @relation(fields: [consultant_id], references: [consultant_id])

  @@unique([consultant_id, consultant_language_code])
  @@map("consultant_language")
}

model ConsultantSpecialization {
  consultant_specialization_id    Int        @id @default(autoincrement())
  consultant_id                   Int
  consultant_specialization_topic String     @db.VarChar(100)
  consultant                      Consultant @relation(fields: [consultant_id], references: [consultant_id])

  @@unique([consultant_id, consultant_specialization_topic])
  @@map("consultant_specialization")
}

model Organization {
  organization_id   Int          @id @default(autoincrement())
  organization_name String       @unique @db.VarChar(100)
  organization_type String?      @db.VarChar(50)
  consultants       Consultant[]

  @@map("organization")
}

// ==========================================
// ⏰ TIME SLOT (ผูก consultant + university)
// ==========================================

model TimeSlot {
  time_slot_id             Int            @id @default(autoincrement())
  university_id            Int
  time_slot_start_datetime DateTime       @db.Timestamptz(3)
  time_slot_end_datetime   DateTime       @db.Timestamptz(3)
  time_slot_max_capacity   Int            @default(1)
  time_slot_status         TimeSlotStatus @default(AVAILABLE)

  university University @relation(fields: [university_id], references: [university_id])

  // ✅ จากเดิม Booking? (1-1) -> Booking[] (1-many)
  bookings Booking[]

  // ✅ กันเวลาซ้ำ "ระดับมหาลัย" (คิวรวม)
  @@unique([university_id, time_slot_start_datetime, time_slot_end_datetime])
  @@index([university_id, time_slot_start_datetime])
  @@map("time_slot")
}

// ==========================================
// 📅 BOOKING (1 booking = 1 slot, 1 slot ถูกจองได้ครั้งเดียว)
// ==========================================

model Booking {
  booking_id          Int  @id @default(autoincrement())
  university_id       Int
  student_id          Int
  consultant_id       Int?
  time_slot_id        Int
  problem_category_id Int

  booking_detail_text String?       @db.Text
  booking_status      BookingStatus @default(PENDING_ASSIGNMENT)
  booking_created_at  DateTime      @default(now())
  booking_updated_at  DateTime      @default(now()) @updatedAt

  university University  @relation(fields: [university_id], references: [university_id])
  student    Student     @relation(fields: [student_id], references: [student_id])
  consultant Consultant? @relation(fields: [consultant_id], references: [consultant_id])

  // ✅ จากเดิม 1-1 -> 1-many
  timeSlot TimeSlot @relation(fields: [time_slot_id], references: [time_slot_id])

  problemCategory ProblemCategory @relation(fields: [problem_category_id], references: [problem_category_id])

  assignments       BookingAssignment[]
  cancellation      BookingCancellation?
  outcome           BookingOutcome?
  feedback          Feedback?
  notifications     Notification[]
  pointTransactions StudentPointTransaction[] @relation("BookingPointTx")

  @@index([time_slot_id])
  @@index([university_id])
  @@index([booking_status])
  @@index([student_id])
  @@index([consultant_id])
  @@index([problem_category_id])
  @@index([student_id, booking_status])
  @@map("booking")
}

model ProblemCategory {
  problem_category_id          Int       @id @default(autoincrement())
  problem_category_code        String    @unique @db.VarChar(20)
  problem_category_name_th     String    @db.VarChar(100)
  problem_category_name_en     String?   @db.VarChar(100)
  problem_category_description String?   @db.Text
  bookings                     Booking[]

  @@map("problem_category")
}

model BookingAssignment {
  booking_assignment_id             Int      @id @default(autoincrement())
  booking_id                        Int
  booking_assignment_assigned_by_id Int
  booking_assignment_assigned_to_id Int
  booking_assignment_note           String?  @db.Text
  booking_assignment_assigned_at    DateTime @default(now())

  assignedBy Consultant @relation("AssignedBy", fields: [booking_assignment_assigned_by_id], references: [consultant_id])
  assignedTo Consultant @relation("AssignedTo", fields: [booking_assignment_assigned_to_id], references: [consultant_id])
  booking    Booking    @relation(fields: [booking_id], references: [booking_id])

  @@index([booking_id])
  @@index([booking_assignment_assigned_by_id])
  @@index([booking_assignment_assigned_to_id])
  @@map("booking_assignment")
}

model BookingOutcome {
  booking_id                      Int      @id
  booking_outcome_consultant_note String   @db.Text
  booking_outcome_next_step       String?  @db.Text
  booking_outcome_risk_level      Int?
  booking_outcome_recorded_at     DateTime @default(now())
  booking                         Booking  @relation(fields: [booking_id], references: [booking_id])

  @@map("booking_outcome")
}

model BookingCancellation {
  booking_id                           Int      @id
  booking_cancellation_cancelled_by_id Int
  booking_cancellation_reason          String   @db.Text
  booking_cancellation_cancelled_at    DateTime @default(now())
  cancelledBy                          Account  @relation(fields: [booking_cancellation_cancelled_by_id], references: [account_id])
  booking                              Booking  @relation(fields: [booking_id], references: [booking_id])

  @@index([booking_cancellation_cancelled_by_id])
  @@map("booking_cancellation")
}

// ==========================================
// ⭐ FEEDBACK
// ==========================================

model Feedback {
  feedback_id           Int              @id @default(autoincrement())
  booking_id            Int              @unique
  student_id            Int
  consultant_id         Int
  feedback_is_anonymous Boolean          @default(true)
  feedback_created_at   DateTime         @default(now())
  booking               Booking          @relation(fields: [booking_id], references: [booking_id])
  consultant            Consultant       @relation(fields: [consultant_id], references: [consultant_id])
  student               Student          @relation(fields: [student_id], references: [student_id])
  comment               FeedbackComment?
  ratings               FeedbackRating[]

  @@index([consultant_id])
  @@index([student_id])
  @@map("feedback")
}

model EvaluationCriterion {
  evaluation_criterion_id            Int              @id @default(autoincrement())
  evaluation_criterion_topic_th      String           @db.VarChar(100)
  evaluation_criterion_topic_en      String?          @db.VarChar(100)
  evaluation_criterion_weight        Decimal          @default(1.00) @db.Decimal(3, 2)
  evaluation_criterion_display_order Int              @default(0)
  ratings                            FeedbackRating[]

  @@map("evaluation_criterion")
}

model FeedbackRating {
  feedback_rating_id      Int                 @id @default(autoincrement())
  feedback_id             Int
  evaluation_criterion_id Int
  feedback_rating_score   Int
  criterion               EvaluationCriterion @relation(fields: [evaluation_criterion_id], references: [evaluation_criterion_id])
  feedback                Feedback            @relation(fields: [feedback_id], references: [feedback_id])

  @@unique([feedback_id, evaluation_criterion_id])
  @@index([evaluation_criterion_id])
  @@map("feedback_rating")
}

model FeedbackComment {
  feedback_id                    Int       @id
  feedback_comment_text          String?   @db.Text
  feedback_comment_admin_reply   String?   @db.Text
  feedback_comment_replied_by_id Int?
  feedback_comment_replied_at    DateTime?
  repliedBy                      Account?  @relation("FeedbackCommentRepliedBy", fields: [feedback_comment_replied_by_id], references: [account_id])
  feedback                       Feedback  @relation(fields: [feedback_id], references: [feedback_id])

  @@index([feedback_comment_replied_by_id])
  @@map("feedback_comment")
}

// ==========================================
// 🔔 NOTIFICATION
// ==========================================

model NotificationTemplate {
  notification_template_id     Int            @id @default(autoincrement())
  notification_template_code   String         @unique @db.VarChar(50)
  notification_template_title  String?        @db.VarChar(200)
  notification_template_body   String?        @db.Text
  notification_template_format String         @default("TEXT") @db.VarChar(20)
  notifications                Notification[]

  @@map("notification_template")
}

model Notification {
  notification_id            Int                  @id @default(autoincrement())
  account_id                 Int
  notification_template_id   Int
  booking_id                 Int?
  notification_channel       String               @default("LINE") @db.VarChar(20)
  notification_data          Json?
  notification_status        String               @default("PENDING") @db.VarChar(20)
  notification_sent_at       DateTime?
  notification_error_message String?              @db.Text
  notification_created_at    DateTime             @default(now())
  account                    Account              @relation(fields: [account_id], references: [account_id])
  booking                    Booking?             @relation(fields: [booking_id], references: [booking_id])
  template                   NotificationTemplate @relation(fields: [notification_template_id], references: [notification_template_id])

  @@index([account_id])
  @@index([notification_status])
  @@index([booking_id])
  @@index([notification_template_id])
  @@map("notification")
}

// ==========================================
// ⭐ POINTS (สะสมแต้ม - เฉพาะนิสิต)
// ==========================================

model PointRule {
  point_rule_id         Int      @id @default(autoincrement())
  point_rule_code       String   @unique @db.VarChar(50)
  point_rule_name_th    String   @db.VarChar(200)
  point_rule_points     Int
  point_rule_is_active  Boolean  @default(true)
  point_rule_created_at DateTime @default(now())

  transactions StudentPointTransaction[]

  @@index([point_rule_is_active])
  @@map("point_rule")
}

model StudentPointWallet {
  student_id               Int      @id
  student_point_balance    Int      @default(0)
  student_point_updated_at DateTime @default(now())

  student Student @relation(fields: [student_id], references: [student_id])

  @@map("student_point_wallet")
}

model StudentPointTransaction {
  student_point_transaction_id Int  @id @default(autoincrement())
  student_id                   Int
  point_rule_id                Int?
  booking_id                   Int?

  student_point_txn_type   PointTxnType
  student_point_amount     Int
  student_point_note       String?      @db.Text
  student_point_created_at DateTime     @default(now())

  student Student    @relation(fields: [student_id], references: [student_id])
  rule    PointRule? @relation(fields: [point_rule_id], references: [point_rule_id])
  booking Booking?   @relation("BookingPointTx", fields: [booking_id], references: [booking_id])

  @@index([student_id])
  @@index([booking_id])
  @@index([point_rule_id])
  @@index([student_point_txn_type])
  @@map("student_point_transaction")
}

// ==========================================
// AI KNOWLEDGE BASE
// ==========================================

model AiKbDocument {
  ai_kb_document_id Int @id @default(autoincrement())

  /// NULL = เอกสารกลาง, มีค่า = เอกสารเฉพาะมหาลัย
  university_id Int?

  ai_kb_document_key      String  @db.VarChar(120)
  ai_kb_document_title    String  @db.VarChar(200)
  ai_kb_document_category String? @db.VarChar(50)
  ai_kb_document_url_hint String? @db.VarChar(200)

  ai_kb_document_is_active Boolean @default(true)

  /// ชี้ไปเวอร์ชันที่ publish ล่าสุดของ document นี้
  ai_kb_published_version_id Int?

  ai_kb_document_created_at DateTime @default(now()) @db.Timestamptz(6)
  ai_kb_document_updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // relations
  university University?           @relation("UniversityAiKbDocuments", fields: [university_id], references: [university_id])
  versions   AiKbDocumentVersion[]
  chunks     AiKbChunk[]
  roles      AiKbDocumentRole[]

  /// publishedVersion relation ทำเป็น optional + no action เพื่อเลี่ยง cycle ตอน migrate
  publishedVersion       AiKbDocumentVersion? @relation("PublishedVersion", fields: [ai_kb_published_version_id], references: [ai_kb_document_version_id], onDelete: NoAction, onUpdate: NoAction)
  resolvedFeedbackEvents AiFeedbackEvent[]    @relation("ResolvedDocument")

  @@unique([university_id, ai_kb_document_key])
  @@index([university_id, ai_kb_document_is_active])
  @@index([ai_kb_document_category])
  @@map("ai_kb_document")
}

model AiKbDocumentRole {
  ai_kb_document_id Int
  ai_actor_role     String @db.VarChar(30) // STUDENT | CONSULTANT | ADMIN | SUPER_ADMIN

  document AiKbDocument @relation(fields: [ai_kb_document_id], references: [ai_kb_document_id], onDelete: Cascade)

  @@id([ai_kb_document_id, ai_actor_role])
  @@map("ai_kb_document_role")
}

model AiKbDocumentVersion {
  ai_kb_document_version_id Int @id @default(autoincrement())
  ai_kb_document_id         Int

  ai_kb_version_no     Int
  ai_kb_content_type   KbContentType
  ai_kb_version_status KbVersionStatus @default(DRAFT)

  /// แนะนำเก็บเป็น path เพื่ออัปโหลด/แก้ไขง่าย
  ai_kb_source_path String? @db.Text
  ai_kb_source_md   String? @db.Text
  ai_kb_source_json Json?

  /// ข้อความที่ normalize เพื่อทำ chunk หรือ search
  ai_kb_normalized_text String? @db.Text

  ai_kb_index_status KbIndexStatus @default(PENDING)
  ai_kb_index_error  String?       @db.Text

  ai_kb_version_created_at DateTime @default(now()) @db.Timestamptz(6)
  ai_kb_version_updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // relations
  document AiKbDocument @relation(fields: [ai_kb_document_id], references: [ai_kb_document_id], onDelete: Cascade)
  chunks   AiKbChunk[]

  /// back relation ของ publishedVersion (จาก AiKbDocument)
  publishedByDocuments AiKbDocument[] @relation("PublishedVersion")

  @@unique([ai_kb_document_id, ai_kb_version_no])
  @@index([ai_kb_index_status])
  @@map("ai_kb_document_version")
}

model AiKbChunk {
  ai_kb_chunk_id Int @id @default(autoincrement())

  ai_kb_document_id         Int
  ai_kb_document_version_id Int

  ai_kb_chunk_index        Int
  ai_kb_chunk_content_text String @db.Text

  /// ถ้ายังไม่ใช้ pgvector เก็บเป็น Json ไปก่อน (เช่น number[])
  ai_kb_chunk_embedding   Json?
  ai_kb_chunk_token_count Int?

  /// NULL = global (ซ้ำกับ doc.university_id ได้ แต่ช่วย query ง่าย)
  university_id Int?

  ai_kb_chunk_created_at DateTime @default(now()) @db.Timestamptz(6)

  // relations
  document   AiKbDocument        @relation(fields: [ai_kb_document_id], references: [ai_kb_document_id], onDelete: Cascade)
  version    AiKbDocumentVersion @relation(fields: [ai_kb_document_version_id], references: [ai_kb_document_version_id], onDelete: Cascade)
  university University?         @relation("UniversityAiKbChunks", fields: [university_id], references: [university_id])

  @@unique([ai_kb_document_version_id, ai_kb_chunk_index])
  @@index([university_id])
  @@map("ai_kb_chunk")
}

model AiFeedbackEvent {
  ai_feedback_event_id Int @id @default(autoincrement())

  university_id Int?
  account_id    Int?
  ai_user_role  String? @db.VarChar(30)

  ai_feedback_type      AiFeedbackType
  ai_user_question_text String         @db.Text

  ai_assistant_reply_excerpt String? @db.VarChar(500)
  ai_top_document_keys       Json?
  ai_debug_meta              Json?

  ai_feedback_status AiFeedbackStatus @default(OPEN)

  /// ถ้าจบเคสแล้วว่า "ควรแก้เอกสารไหน" ก็ชี้กลับไป
  ai_resolved_document_id Int?

  ai_created_at DateTime @default(now()) @db.Timestamptz(6)

  // relations
  university University? @relation("UniversityAiFeedbackEvents", fields: [university_id], references: [university_id])

  account          Account?      @relation(fields: [account_id], references: [account_id])
  resolvedDocument AiKbDocument? @relation("ResolvedDocument", fields: [ai_resolved_document_id], references: [ai_kb_document_id])

  @@index([university_id])
  @@index([ai_feedback_type])
  @@index([ai_feedback_status])
  @@map("ai_feedback_event")
}

model BorrowRequest {
  borrow_request_id Int @id @default(autoincrement())

  // มหาลัยต้นทาง (ผู้ขอ)
  from_university_id      Int
  requested_by_account_id Int

  borrow_request_title  String  @db.VarChar(200)
  borrow_request_reason String  @db.Text
  borrow_request_detail String? @db.Text

  borrow_needed_from DateTime? @db.Timestamptz(3)
  borrow_needed_to   DateTime? @db.Timestamptz(3)

  borrow_needed_count   Int                 @default(1)
  borrow_request_status BorrowRequestStatus @default(DRAFT)

  // submit / approve / reject
  borrow_submitted_at            DateTime? @db.Timestamptz(3)
  borrow_submitted_by_account_id Int?
  borrow_submit_note             String?   @db.Text

  borrow_approved_at            DateTime? @db.Timestamptz(3)
  borrow_approved_by_account_id Int?

  borrow_rejected_at            DateTime? @db.Timestamptz(3)
  borrow_rejected_by_account_id Int?
  borrow_reject_reason          String?   @db.Text

  // audit
  borrow_request_created_at DateTime @default(now()) @db.Timestamptz(3)
  borrow_request_updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  // relations (สำคัญมาก)
  fromUniversity University @relation(fields: [from_university_id], references: [university_id])
  requestedBy    Account    @relation("BorrowRequestedBy", fields: [requested_by_account_id], references: [account_id])

  submittedBy Account? @relation("BorrowSubmittedBy", fields: [borrow_submitted_by_account_id], references: [account_id])
  approvedBy  Account? @relation("BorrowApprovedBy", fields: [borrow_approved_by_account_id], references: [account_id])
  rejectedBy  Account? @relation("BorrowRejectedBy", fields: [borrow_rejected_by_account_id], references: [account_id])

  assignments BorrowAssignment[] // ✅ 1 -> many

  @@index([from_university_id])
  @@index([requested_by_account_id])
  @@index([borrow_request_status])
  @@index([borrow_request_created_at])
  @@map("borrow_request")
}

model BorrowAssignment {
  borrow_assignment_id Int @id @default(autoincrement())

  borrow_request_id Int

  consultant_id            Int
  consultant_university_id Int

  borrow_assign_start_at DateTime @db.Timestamptz(3)
  borrow_assign_end_at   DateTime @db.Timestamptz(3)

  borrow_assigned_by_account_id Int
  borrow_assignment_note        String?  @db.Text
  borrow_assigned_at            DateTime @default(now()) @db.Timestamptz(3)

  // relations
  borrowRequest        BorrowRequest @relation(fields: [borrow_request_id], references: [borrow_request_id], onDelete: Cascade)
  consultant           Consultant    @relation(fields: [consultant_id], references: [consultant_id])
  consultantUniversity University    @relation(fields: [consultant_university_id], references: [university_id])
  assignedBy           Account       @relation("BorrowAssignedBy", fields: [borrow_assigned_by_account_id], references: [account_id])

  // ✅ กันคนเดิมซ้ำใน request เดียวกัน
  @@unique([borrow_request_id, consultant_id])
  @@index([borrow_request_id])
  @@index([consultant_id])
  @@index([consultant_university_id])
  @@index([borrow_assigned_by_account_id])
  @@map("borrow_assignment")
}

